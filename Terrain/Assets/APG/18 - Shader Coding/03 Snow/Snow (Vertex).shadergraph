{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "5ad1b92c728b4c53a6a8a35aa89692fc",
    "m_Title": "Object vs World space",
    "m_Content": "SnowDirection is in World space.\nThe Vertex Shader works in Object space.\nFor this to work, both the Normal and the SnowDirection have to be expressed in the same space.\n\nIn this, we converted SnowDirection from World to Object space.\nWe could have also used the Normal in World space instead.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -2448.0,
        "y": -271.3333435058594,
